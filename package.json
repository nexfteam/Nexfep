{
  "name": "nexfep",
  "version": "0.5.3",
  "description": "A desktop application framework based on @webviewjs/webview",
  "keywords": [
    "@webviewjs/webview",
    "application",
    "desktop",
    "framework",
    "typescript",
    "webview"
  ],
  "homepage": "https://github.com/nexfteam/Nexfep#readme",
  "bugs": {
    "url": "https://github.com/nexfteam/Nexfep/issues"
  },
  "license": "MIT",
  "author": "nexfteam",
  "repository": "https://github.com/nexfteam/Nexfep",
  "bin": {
    "nexfep": "cli/index.mjs"
  },
  "typesVersions": {
    "*": {
      ".": ["./index.d.ts"],
      "frontend": ["./frontend/index.d.ts"]
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "README-CN.md",
    "LICENSE",
    "package.json",
    "cli/index.mjs",
    "cli/help.mjs",
    "cli/build.mjs",
    "cli/timeTyper.mjs",
    "src/WindowManager.js",
    "src/WindowManager.d.ts",
    "src/Application.js",
    "src/Application.d.ts",
    "src/Tray.js",
    "src/Tray.d.ts",
    "src/Logger.js",
    "src/Logger.d.ts",
    "src/SingleInstance.js",
    "src/SingleInstance.d.ts",
    "frontend/index.d.ts"
  ],
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "compile": "tsc",
    "fmt": "oxfmt --check",
    "lint": "oxlint",
    "fmt:fix": "oxfmt",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@nexfteam/single-instance": "^0.0.7",
    "@webviewjs/webview": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
